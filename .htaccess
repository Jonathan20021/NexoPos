# ============================================================
#  NexoPOS — Seguridad (Apache)
# ============================================================

# Sin listado de directorios
Options -Indexes

# ----- Cabeceras de seguridad -----
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # camera=(self): el escáner de códigos de barras usa la cámara del teléfono
  # (modules/inventario/escaner.php y el botón de escanear del POS). Con
  # `camera=()` el navegador la niega en seco, sin preguntar y sin explicar por
  # qué. El micrófono y la ubicación siguen bloqueados: nada los usa.
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(self)"
  Header always set X-XSS-Protection "1; mode=block"
  # HSTS: el navegador recuerda que este dominio es solo-HTTPS y ni siquiera
  # intenta el http. Se arranca con 1 día a propósito, no con un año.
  #
  # HSTS NO SE PUEDE DESHACER a voluntad: el navegador respeta el plazo que ya
  # guardó. Si el certificado dejara de renovarse, el sitio no daría un aviso
  # saltable sino un muro, y durante todo ese plazo. Con 86400 el sistema se
  # recupera solo en 24 horas.
  #
  # Cuando lleven un par de semanas sin incidencias con la renovación, sube el
  # valor a 31536000 (un año), que es el recomendado.
  Header always set Strict-Transport-Security "max-age=86400; includeSubDomains"
</IfModule>

# ----- Bloquear archivos sensibles por extensión / nombre -----
<FilesMatch "\.(sql|md|json|lock|sh|ya?ml|ini|log|dist|bak|sample)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# config.local.php / *.local.php / *.example.php — credenciales y plantillas
<FilesMatch "(\.local\.php|\.example\.php)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# ----- Bloquear dotfiles (.git, .env, .gitignore, .htaccess...) -----
<FilesMatch "^\.">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Por si el directorio .git llegara a publicarse, devolver 404
RedirectMatch 404 /\.git(/|$)

# ----- Documento por defecto -----
DirectoryIndex index.php

# ============================================================
#  URLs limpias (sin la extensión .php)
#
#  /modules/pos/ventas   se sirve con   modules/pos/ventas.php
#  /tienda/              se sirve con   tienda/index.php
#
#  Las direcciones viejas con .php siguen funcionando: se redirigen con 301 a la
#  versión limpia, así los enlaces ya enviados por correo no se rompen.
#  La redirección es SOLO para peticiones GET: un 301 sobre un POST haría que el
#  navegador reenviara el formulario como GET y se perderían los datos.
# ============================================================
<IfModule mod_rewrite.c>
  RewriteEngine On

  # MultiViews haría su propia negociación de extensiones y chocaría con estas reglas.
  <IfModule mod_negotiation.c>
    Options -MultiViews
  </IfModule>

  # ----------------------------------------------------------------
  # 0) Todo por HTTPS. Va PRIMERO: el resto de reglas solo deben correr
  #    sobre una petición ya cifrada.
  #
  #    Por qué importa en este sistema y no es solo higiene:
  #      · La cookie de sesión solo lleva el atributo `secure` cuando se
  #        llegó por TLS (app/bootstrap.php lo decide así). Por http viaja
  #        en claro y quien comparta el WiFi del almacén puede quedarse con
  #        la sesión de un cajero.
  #      · El escáner de códigos de barras usa la cámara, y el navegador la
  #        niega fuera de un contexto seguro. Por http falla siempre.
  #
  #    La segunda condición mira la cabecera del proxy: si el TLS lo termina
  #    un balanceador y le pasa la petición a Apache en claro, `%{HTTPS}`
  #    vale "off" SIEMPRE y una regla ingenua redirige en bucle infinito,
  #    dejando el sistema inaccesible. Con las dos condiciones no puede pasar.
  # ----------------------------------------------------------------
  #    Y se deja fuera el desarrollo local: XAMPP sirve https con un certificado
  #    autofirmado, así que forzarlo ahí solo produce un aviso a pantalla completa
  #    en cada carga. En localhost el navegador ya considera seguro el http, de
  #    modo que la cámara y la cookie funcionan igual.
  RewriteCond %{HTTP_HOST} !^localhost$ [NC]
  RewriteCond %{HTTP_HOST} !^127\.0\.0\.1
  RewriteCond %{HTTP_HOST} !^\[?::1\]?$
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]

  # 1) /ruta/index.php  ->  /ruta/     (301, solo GET)
  RewriteCond %{REQUEST_METHOD} =GET
  RewriteCond %{THE_REQUEST} \s([^?\s]*/)index\.php(\?[^\s]*)?\s [NC]
  RewriteRule ^ %1 [R=301,L,NE]

  # 2) /ruta.php  ->  /ruta            (301, solo GET)
  RewriteCond %{REQUEST_METHOD} =GET
  RewriteCond %{THE_REQUEST} \s([^?\s]*)\.php(\?[^\s]*)?\s [NC]
  RewriteRule ^ %1 [R=301,L,NE]

  # 3) Servir /ruta con el archivo /ruta.php, sin cambiar lo que ve el usuario.
  #    Nunca se toca un archivo o carpeta que exista de verdad (imágenes, CSS...).
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule ^(.+?)/?$ $1.php [L]

  # 4) Lo que no exista se sirve con la página 404 del sistema (con su marca) en
  #    vez de la pantalla gris de Apache. Va por RewriteRule y no por
  #    ErrorDocument porque este último se resuelve contra la raíz del servidor:
  #    con la app en una subcarpeta apuntaría a una ruta inexistente.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ modules/auth/404.php [L]
</IfModule>
