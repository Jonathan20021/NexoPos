# ============================================================
#  NexoPOS — archivos que NUNCA deben subirse al repositorio
# ============================================================

# --- Credenciales / configuración local (¡crítico!) ---
# Cualquier *.local.php de config/: el de XAMPP y el de acceso remoto a producción.
# El .htaccess de la raíz además bloquea su lectura por HTTP.
/config/*.local.php
# Bundle de CA propio de cada red para la API de facturación electrónica.
/config/*.local.crt
.env
.env.*

# --- Subidas de usuarios (logo, imágenes de productos) ---
/assets/uploads/*
!/assets/uploads/.gitkeep

# Excepción: el catálogo de fotos de las marcas SÍ va versionado.
# No son subidas de un usuario: son material del proveedor que acompaña al
# catálogo y tiene que llegar al servidor con el despliegue, porque no hay otra
# vía. Ver includes/uploads.php: estas fotos nunca se borran al reemplazarlas.
!/assets/uploads/productos/
/assets/uploads/productos/*
!/assets/uploads/productos/inglot/

# --- Respaldos SQL generados ---
respaldo_*.sql
*.bak

# --- Cargas de datos reales del cliente (PII) ---
# Nóminas y padrones traen cédulas, salarios y cuentas bancarias de personas.
# Se generan a mano desde los Excel del cliente y se aplican con mysql; el
# repositorio es público en GitHub y esto no puede viajar en él.
/database/*.local.sql

# --- Bloqueo de instalación (se genera en cada servidor) ---
/install/installed.lock

# --- Logs y temporales ---
*.log
/logs/
*.cache
*.tmp

# --- Dependencias de desarrollo (Composer dev) ---
# vendor/ SÍ se versiona para que el deploy en cPanel funcione sin ejecutar composer.
/vendor/bin/

# --- Sistema operativo / editores ---
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*~
